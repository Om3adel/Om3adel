<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 340" width="1200" height="340" role="img" aria-labelledby="title desc">
  <title id="title">Omar Mohamed Adel · Data Analyst · Power BI Specialist</title>
  <desc id="desc">Space banner: twinkling stars, a glowing black hole and a satellite on orbit around Omar's name.</desc>

  <defs>
    <linearGradient id="space" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#05050a"/>
      <stop offset="0.55" stop-color="#0a0a12"/>
      <stop offset="1" stop-color="#07070d"/>
    </linearGradient>
    <radialGradient id="nebulaPurple" cx="0.22" cy="0.25" r="0.55">
      <stop offset="0" stop-color="#8b5cf6" stop-opacity="0.32"/>
      <stop offset="1" stop-color="#8b5cf6" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="nebulaCyan" cx="0.55" cy="1" r="0.6">
      <stop offset="0" stop-color="#06b6d4" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#06b6d4" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="holeGlow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.35" stop-color="#fbbf24" stop-opacity="0.35"/>
      <stop offset="0.7" stop-color="#f97316" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#f97316" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="disk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7c2d12" stop-opacity="0"/>
      <stop offset="0.2" stop-color="#f97316"/>
      <stop offset="0.5" stop-color="#fffbeb"/>
      <stop offset="0.8" stop-color="#f97316"/>
      <stop offset="1" stop-color="#7c2d12" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="titleGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#06b6d4"/>
      <stop offset="1" stop-color="#8b5cf6"/>
    </linearGradient>
    <linearGradient id="edge" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#06b6d4" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#8b5cf6"/>
      <stop offset="1" stop-color="#06b6d4" stop-opacity="0"/>
    </linearGradient>
    <filter id="soft" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.2"/>
    </filter>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <clipPath id="frame"><rect width="1200" height="340" rx="22"/></clipPath>
  </defs>

  <style>
    .star { fill: #fff; animation: twinkle 4s ease-in-out infinite; }
    .s2 { animation-delay: -1s; } .s3 { animation-delay: -2s; } .s4 { animation-delay: -3s; }
    @keyframes twinkle { 0%, 100% { opacity: .25; } 50% { opacity: 1; } }
    .ring { transform-origin: 1000px 165px; animation: spin 18s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .pulse { animation: pulse 3.2s ease-in-out infinite; transform-origin: 1000px 165px; }
    @keyframes pulse { 0%, 100% { opacity: .75; } 50% { opacity: 1; } }
    .dot { animation: blink 1.6s ease-in-out infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
    .rise { animation: rise 1s cubic-bezier(.2,.8,.2,1) both; }
    .d1 { animation-delay: .15s; } .d2 { animation-delay: .3s; } .d3 { animation-delay: .45s; }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    text { font-family: 'Segoe UI', Ubuntu, 'Helvetica Neue', Arial, sans-serif; }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
  </style>

  <g clip-path="url(#frame)">
    <!-- deep space + nebula glows -->
    <rect width="1200" height="340" fill="url(#space)"/>
    <rect width="1200" height="340" fill="url(#nebulaPurple)"/>
    <rect width="1200" height="340" fill="url(#nebulaCyan)"/>

    <!-- stars -->
    <g>
      <circle class="star" cx="60" cy="40" r="1.2"/>
      <circle class="star s2" cx="140" cy="290" r="1"/>
      <circle class="star s3" cx="230" cy="70" r="1.5"/>
      <circle class="star s4" cx="310" cy="300" r="1"/>
      <circle class="star" cx="395" cy="28" r="1"/>
      <circle class="star s3" cx="470" cy="315" r="1.4"/>
      <circle class="star s2" cx="540" cy="60" r="1"/>
      <circle class="star s4" cx="610" cy="22" r="1.3"/>
      <circle class="star" cx="660" cy="300" r="1"/>
      <circle class="star s3" cx="720" cy="45" r="1"/>
      <circle class="star s2" cx="780" cy="310" r="1.5"/>
      <circle class="star s4" cx="830" cy="30" r="1"/>
      <circle class="star" cx="880" cy="290" r="1.1"/>
      <circle class="star s2" cx="1120" cy="40" r="1.4"/>
      <circle class="star s3" cx="1160" cy="270" r="1"/>
      <circle class="star s4" cx="1080" cy="310" r="1.2"/>
      <circle class="star" cx="35" cy="200" r="1"/>
      <circle class="star s2" cx="590" cy="190" r="0.9"/>
      <circle class="star s3" cx="905" cy="120" r="1"/>
      <circle class="star s4" cx="1170" cy="150" r="1.1"/>
      <circle cx="180" cy="160" r="0.8" fill="#a5f3fc" opacity=".6"/>
      <circle cx="700" cy="150" r="0.8" fill="#c4b5fd" opacity=".6"/>
      <circle cx="950" cy="320" r="0.9" fill="#fde68a" opacity=".5"/>
    </g>

    <!-- black hole (right) -->
    <g>
      <circle cx="1000" cy="165" r="120" fill="url(#holeGlow)" class="pulse"/>
      <g class="ring">
        <ellipse cx="1000" cy="165" rx="78" ry="78" fill="none" stroke="#fbbf24" stroke-opacity=".55" stroke-width="10" stroke-dasharray="40 18 90 24" filter="url(#soft)"/>
      </g>
      <ellipse cx="1000" cy="168" rx="150" ry="13" fill="url(#disk)" opacity=".9" filter="url(#soft)" class="pulse"/>
      <circle cx="1000" cy="165" r="50" fill="#000"/>
      <circle cx="1000" cy="165" r="51.5" fill="none" stroke="#fde68a" stroke-opacity=".9" stroke-width="1.6" filter="url(#glow)"/>
      <!-- front half of the disk crosses over the hole -->
      <path d="M850 168 Q1000 186 1150 168" fill="none" stroke="url(#disk)" stroke-width="5" opacity=".85" filter="url(#soft)"/>
    </g>

    <!-- orbit + satellite around the title -->
    <ellipse cx="360" cy="168" rx="330" ry="118" fill="none" stroke="#8b5cf6" stroke-opacity=".28" stroke-dasharray="3 7"/>
    <g>
      <g>
        <rect x="-5" y="-4" width="10" height="8" rx="1.5" fill="#e4e4e7"/>
        <rect x="-19" y="-3" width="12" height="6" fill="#06b6d4" opacity=".9"/>
        <rect x="7" y="-3" width="12" height="6" fill="#06b6d4" opacity=".9"/>
        <circle r="10" fill="#06b6d4" opacity=".18"/>
        <animateMotion dur="16s" repeatCount="indefinite" rotate="auto"
          path="M690 168 A330 118 0 1 1 30 168 A330 118 0 1 1 690 168"/>
      </g>
    </g>

    <!-- text -->
    <g transform="translate(70 0)">
      <g class="rise">
        <rect x="0" y="62" width="336" height="28" rx="14" fill="#06b6d4" fill-opacity=".1" stroke="#06b6d4" stroke-opacity=".45"/>
        <circle class="dot" cx="20" cy="76" r="4.5" fill="#34d399"/>
        <text x="34" y="81" font-size="13" font-weight="700" letter-spacing="2.4" fill="#67e8f9">MISSION CONTROL · CAIRO, EGYPT</text>
      </g>
      <text class="rise d1" x="0" y="160" font-size="58" font-weight="800" fill="#ffffff" letter-spacing="-1">Omar Mohamed Adel</text>
      <text class="rise d2" x="2" y="206" font-size="27" font-weight="700" fill="url(#titleGrad)">Data Analyst · Power BI Specialist</text>
      <text class="rise d3" x="2" y="246" font-size="17" fill="#a1a1aa">Your data has secrets. I spy.  ·  From satellite orbits to business KPIs</text>
    </g>

    <!-- bottom glowing edge -->
    <rect x="0" y="337" width="1200" height="3" fill="url(#edge)"/>
  </g>
</svg>
